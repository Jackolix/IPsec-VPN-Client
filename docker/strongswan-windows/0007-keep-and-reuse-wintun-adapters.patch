 /** how long to wait for an installed address to show up, and how often to look */
 #define ADDR_WAIT_MS 2000
 #define ADDR_POLL_MS 20
@@ -751,12 +792,159 @@
 			return TRUE;
 		}
 		this->mutex->unlock(this->mutex);
+		refresh_ifaces(this);
 		Sleep(ADDR_POLL_MS);
