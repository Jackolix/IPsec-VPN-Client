 /**
+ * How many idle adapters to keep for the next tunnel.
+ *
+ * Creating a Wintun adapter is a PnP device install: two seconds on a quiet
+ * machine, four and more on a busy one, measured in the middle of every
+ * connect between "installing new virtual IP" and "created Wintun device".
+ * It was the largest single step of a Windows connect, and one macOS does not
+ * have (a utun costs nothing). Wintun removes an adapter when its handle is
+ * closed, so the only way to not pay it again is to not close it: an adapter
+ * whose tunnel went down is cleared and kept, and the next tunnel takes it.
+ *
+ * Kept bounded, because each one is a visible (if addressless and idle)
+ * network adapter; beyond this many the old teardown applies.
+ */
+#define SPARE_TUNS 2
+
+/**
  * Destroy an entry, taking its adapter down with it
  */
 static void vip_tun_destroy(vip_tun_t *entry)
@@ -724,6 +748,23 @@
 	return ConvertInterfaceGuidToLuid(&guid, luid) == NO_ERROR;
 }
 
+/**
+ * Re-read every adapter's addresses now, rather than wait to be told.
+ *
+ * The interface list is fed by NotifyIpInterfaceChange(), which reports
+ * changes to an *interface*: one appearing, or its state flipping. A freshly
+ * created adapter does both while its first address goes on, so the address
+ * always arrived with them. An address added to an adapter that is already up
+ * -- a kept one, see park_tun() -- changes no interface, nothing is reported,
+ * and charon never learns the address is there: add_ip() gave up on it as
+ * "did not appear", tore the adapter down, and the tunnel came up with no
+ * virtual IP and routes sourced from the physical address. Not under the mutex.
+ */
+static void refresh_ifaces(private_kernel_iph_net_t *this)
+{
+	change_interface(this, NULL, MibParameterNotification);
+}
