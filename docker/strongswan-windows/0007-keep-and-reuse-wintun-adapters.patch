 /**
+ * Remove what a tunnel left on an adapter we are about to keep: its address,
+ * and any route still pointing at it. The route should already be gone --
+ * kernel-libipsec removes each with the last CHILD_SA using it -- but an
+ * adapter waiting for its next tunnel must not carry traffic for its last one,
+ * so anything static that survived goes too.
+ *
+ * Returns FALSE unless the adapter is known to be clean. A kept adapter that
+ * still held its old address would hand the next tunnel two addresses on one
+ * adapter -- the source-selection fault 0003 exists to prevent -- and one that
+ * still held a route would keep pulling that network's traffic into a tunnel
+ * that no longer carries it.
+ */
+static bool clear_tun(NET_LUID luid, host_t *ip)
+{
+	MIB_UNICASTIPADDRESS_ROW addr;
+	MIB_IPFORWARD_TABLE2 *table;
+	bool clean = TRUE;
+	ULONG i, ret;
+
+	InitializeUnicastIpAddressEntry(&addr);
+	addr.InterfaceLuid = luid;
+	memcpy(&addr.Address, ip->get_sockaddr(ip), *ip->get_sockaddr_len(ip));
+	ret = DeleteUnicastIpAddressEntry(&addr);
+	if (ret != NO_ERROR && ret != ERROR_NOT_FOUND)
+	{
+		DBG1(DBG_KNL, "removing %H from a released adapter failed: 0x%08lx",
+			 ip, ret);
+		clean = FALSE;
+	}
+
+	if (GetIpForwardTable2(AF_UNSPEC, &table) != NO_ERROR)
+	{
+		return FALSE;
+	}
+	for (i = 0; i < table->NumEntries; i++)
+	{
+		if (table->Table[i].InterfaceLuid.Value == luid.Value &&
+			table->Table[i].Protocol == MIB_IPPROTO_NETMGMT)
+		{
+			ret = DeleteIpForwardEntry2(&table->Table[i]);
+			if (ret != NO_ERROR && ret != ERROR_NOT_FOUND)
+			{
+				DBG1(DBG_KNL, "removing a route from a released adapter "
+					 "failed: 0x%08lx", ret);
+				clean = FALSE;
+			}
+		}
+	}
+	FreeMibTable(table);
+	return clean;
+}
+
+/**
+ * Release a device whose last holder is gone: keep it for the next tunnel if
+ * there is room, tear it down otherwise. It must already be unregistered from
+ * charon, so nothing routes into it while it is cleared. Not under the mutex.
+ */
+static void park_tun(private_kernel_iph_net_t *this, vip_tun_t *entry,
+					 host_t *ip)
+{
+	bool keep;
+
+	if (!clear_tun(entry->luid, ip))
+	{	/* rather a device install on the next connect than a tunnel that
+		 * inherits this one's address or routes */
+		DBG1(DBG_KNL, "not keeping adapter '%s': it could not be cleared",
+			 entry->tun->get_name(entry->tun));
+		vip_tun_destroy(entry);
+		return;
+	}
+	/* and drop it from our view now: a next tunnel given the same address
+	 * would otherwise find it "already there" before it is installed again */
+	refresh_ifaces(this);
+
+	this->mutex->lock(this->mutex);
+	keep = this->spares->get_count(this->spares) < SPARE_TUNS;
+	if (keep)
+	{
+		this->spares->insert_last(this->spares, entry->tun);
+	}
+	this->mutex->unlock(this->mutex);
+
+	if (keep)
+	{
+		DBG2(DBG_KNL, "keeping adapter '%s' for the next tunnel",
+			 entry->tun->get_name(entry->tun));
+		free(entry);
+		return;
+	}
+	vip_tun_destroy(entry);
+}
+
+/**
+ * A kept adapter for a new virtual IP, or a new one when none is kept.
+ */
+static tun_device_t *take_tun(private_kernel_iph_net_t *this)
+{
+	tun_device_t *tun = NULL;
+
+	this->mutex->lock(this->mutex);
+	this->spares->remove_first(this->spares, (void**)&tun);
+	this->mutex->unlock(this->mutex);
+
+	if (tun)
+	{
+		DBG2(DBG_KNL, "reusing adapter '%s'", tun->get_name(tun));
+		return tun;
+	}
+	return lib->tun->create(lib->tun, NULL);
+}
+
+/**
+ * Create one adapter ahead of the first tunnel, so that tunnel finds it kept
+ * rather than waiting for a device install. Runs as a job: charon is not yet
+ * answering vici while plugins load, and nobody is waiting on this.
+ */
+static job_requeue_t warm_spare(private_kernel_iph_net_t *this)
+{
+	tun_device_t *tun;
+	bool keep;
+
+	tun = lib->tun->create(lib->tun, NULL);
+	if (!tun)
+	{
+		return JOB_REQUEUE_NONE;
+	}
+	this->mutex->lock(this->mutex);
+	keep = this->spares->get_count(this->spares) < SPARE_TUNS;
+	if (keep)
+	{
+		this->spares->insert_last(this->spares, tun);
+	}
+	this->mutex->unlock(this->mutex);
+	if (keep)
+	{
+		DBG2(DBG_KNL, "adapter '%s' ready for the first tunnel",
+			 tun->get_name(tun));
+	}
+	else
+	{
+		tun->destroy(tun);
+	}
+	return JOB_REQUEUE_NONE;
+}
+
+/**
  * Unregister and destroy a TUN device add_ip() could not finish setting up
  */
 static void drop_tun(private_kernel_iph_net_t *this, vip_tun_t *entry)
@@ -814,7 +1002,7 @@
