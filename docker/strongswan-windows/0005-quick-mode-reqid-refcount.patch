 					{
 						this->rekey = child_sa->get_spi(child_sa, TRUE);
-						this->child.reqid = child_sa->get_reqid(child_sa);
+						/* take a reference, don't just read the number: this
+						 * task's destroy() releases child.reqid unconditionally,
+						 * so storing an unreferenced reqid here is one release
+						 * too many per rekey. use_reqid() below already refs
+						 * before it stores, for the same reason. */
+						this->child.reqid = child_sa->get_reqid_ref(child_sa);
 						this->child.mark_in = child_sa->get_mark(child_sa,
 																 TRUE).value;
 						this->child.mark_out = child_sa->get_mark(child_sa,
