+#else /* WIN32 */
+
+/**
+  * Functions offered by the Wintun dynamic library
+  */
+static WINTUN_CREATE_ADAPTER_FUNC *WintunCreateAdapter;
+static WINTUN_CLOSE_ADAPTER_FUNC *WintunCloseAdapter;
+static WINTUN_OPEN_ADAPTER_FUNC *WintunOpenAdapter;
+static WINTUN_GET_ADAPTER_LUID_FUNC *WintunGetAdapterLUID;
+static WINTUN_GET_RUNNING_DRIVER_VERSION_FUNC *WintunGetRunningDriverVersion;
+static WINTUN_DELETE_DRIVER_FUNC *WintunDeleteDriver;
+static WINTUN_SET_LOGGER_FUNC *WintunSetLogger;
+static WINTUN_START_SESSION_FUNC *WintunStartSession;
+static WINTUN_END_SESSION_FUNC *WintunEndSession;
+static WINTUN_GET_READ_WAIT_EVENT_FUNC *WintunGetReadWaitEvent;
+static WINTUN_RECEIVE_PACKET_FUNC *WintunReceivePacket;
+static WINTUN_RELEASE_RECEIVE_PACKET_FUNC *WintunReleaseReceivePacket;
+static WINTUN_ALLOCATE_SEND_PACKET_FUNC *WintunAllocateSendPacket;
+static WINTUN_SEND_PACKET_FUNC *WintunSendPacket;
+
+static HMODULE Wintun;
+
+/**
+ * Name and type the adapter shows up with in Windows
+ */
+#define WINTUN_ADAPTER_NAME  L"strongSwan"
+#define WINTUN_TUNNEL_TYPE   L"strongSwan"
+
+/**
+ * Capacity of the send/receive rings, 2 MiB each (must be a power of two
+ * between 128 KiB and 64 MiB)
+ */
+#define WINTUN_RING_CAPACITY 0x200000
+
+/**
+ * An interface name here is the adapter's GUID, "{...}" plus terminator
+ */
+#define TUN_NAME_LEN     40
+
+#define TUN_DEFAULT_MTU  1500
+
+/**
+ * How long to wait for a freshly created adapter's IP interface to turn up in
+ * the TCP/IP stack, and how often to look.
+ *
+ * WintunCreateAdapter() returns as soon as the device exists and has a LUID,
+ * but Windows registers the IP interface for it asynchronously -- until that
+ * lands, GetIpInterfaceEntry() answers ERROR_NOT_FOUND. On an idle machine the
+ * gap is imperceptible; at boot, with the PnP subsystem busy, it routinely
+ * outlasts the call. Losing that race used to fail the device outright, which
+ * takes kernel-libipsec (a critical plugin) down with it and so leaves charon
+ * dead until the service is restarted -- a whole session without IPsec because
+ * of a few hundred milliseconds. Wait it out instead.
+ */
+#define IFACE_WAIT_MS    10000
+#define IFACE_POLL_MS    200
+
+typedef struct private_wintun_device_t private_wintun_device_t;
+
+struct private_wintun_device_t {
+
+	/**
+	 * Public interface
+	 */
+	wintun_device_t public;
+
+	/**
+	 * Wintun adapter handle
+	 */
+	WINTUN_ADAPTER_HANDLE adapter;
+
+	/**
+	 * Wintun session (the two packet rings) on that adapter
+	 */
+	WINTUN_SESSION_HANDLE session;
+
+	/**
+	 * LUID of the adapter, to configure it via the IP Helper API
+	 */
+	NET_LUID luid;
+
+	/**
+	 * Adapter GUID, the name charon knows this device by
+	 */
+	char if_name[TUN_NAME_LEN];
+
+	/**
+	 * The current MTU
+	 */
+	int mtu;
+
+	/**
+	 * Associated address
+	 */
+	host_t *address;
+
+	/**
+	 * Netmask for address
+	 */
+	uint8_t netmask;
+
+	/**
+	 * Socketpair bridging the adapter to the poll()-based packet router:
+	 * [0] is handed out as the device's fd, [1] is fed by the reader thread.
+	 */
+	int fds[2];
+
+	/**
+	 * Signaled to make the reader thread return
+	 */
+	HANDLE quit;
+
+	/**
+	 * Thread pumping packets from the adapter into the socketpair
+	 */
+	thread_t *reader;
+};
+
+/**
+ * Write a full buffer to a socket, blocking until it is out
+ */
+static bool write_all(int fd, void *buf, size_t len)
+{
+	uint8_t *pos = buf;
+
+	while (len)
+	{
+		ssize_t out = write(fd, pos, len);
+
+		if (out <= 0)
+		{
+			return FALSE;
+		}
+		pos += out;
+		len -= out;
+	}
+	return TRUE;
+}
+
+/**
+ * Read a full buffer from a socket, blocking until it is in
+ */
+static bool read_all(int fd, void *buf, size_t len)
+{
+	uint8_t *pos = buf;
+
+	while (len)
+	{
+		ssize_t in = read(fd, pos, len);
+
+		if (in <= 0)
+		{
+			return FALSE;
+		}
+		pos += in;
+		len -= in;
+	}
+	return TRUE;
+}
+
+/**
+ * Move packets from the adapter's receive ring into the socketpair.
+ *
+ * Wintun signals readability with an event, but the packet router polls file
+ * descriptors, so the two have to be bridged: this thread waits on the event
+ * and writes each packet, length-prefixed, into a loopback socket the router
+ * can poll(). The router reads them back in read_packet().
+ */
+static void *reader_thread(private_wintun_device_t *this)
+{
+	HANDLE events[] = {
+		this->quit,
+		WintunGetReadWaitEvent(this->session),
+	};
+
+	while (TRUE)
+	{
+		uint8_t hdr[sizeof(uint16_t)];
+		bool ok = TRUE;
+		BYTE *packet;
+		DWORD size;
+
+		packet = WintunReceivePacket(this->session, &size);
+		if (packet)
+		{
+			if (size && size <= UINT16_MAX)
+			{
+				htoun16(hdr, size);
+				ok = write_all(this->fds[1], hdr, sizeof(hdr)) &&
+					 write_all(this->fds[1], packet, size);
+			}
+			WintunReleaseReceivePacket(this->session, packet);
+
+			if (!ok)
+			{	/* the router is gone, or the device is being destroyed */
+				break;
+			}
+			continue;
+		}
+		if (GetLastError() != ERROR_NO_MORE_ITEMS)
+		{
+			DBG1(DBG_LIB, "reading from Wintun device failed: 0x%08lx",
+				 GetLastError());
+			break;
+		}
+		/* ring drained, wait for the adapter to signal more (or for quit) */
+		if (WaitForMultipleObjects(countof(events), events, FALSE,
+								   INFINITE) != WAIT_OBJECT_0 + 1)
+		{
+			break;
+		}
+	}
+	return NULL;
+}
+
+/**
+ * Set the MTU of the adapter for the given address family
+ */
+static bool set_iface_mtu(private_wintun_device_t *this, int mtu,
+						  ADDRESS_FAMILY family)
+{
+	MIB_IPINTERFACE_ROW row;
+	DWORD ret;
+	int waited;
+
+	/* Only ERROR_NOT_FOUND is worth waiting on -- that is the interface not
+	 * being registered *yet*. Any other failure is a real one, so report it
+	 * at once rather than sitting out the timeout. */
+	for (waited = 0; ; waited += IFACE_POLL_MS)
+	{
+		InitializeIpInterfaceEntry(&row);
+		row.Family = family;
+		row.InterfaceLuid = this->luid;
+
+		ret = GetIpInterfaceEntry(&row);
+		if (ret != ERROR_NOT_FOUND || waited >= IFACE_WAIT_MS)
+		{
+			break;
+		}
+		Sleep(IFACE_POLL_MS);
+	}
+	if (ret != NO_ERROR)
+	{
+		DBG1(DBG_LIB, "getting interface entry for %s failed: 0x%08lx "
+			 "(gave up after %dms)", this->if_name, ret, waited);
+		return FALSE;
+	}
+	if (waited)
+	{
+		DBG1(DBG_LIB, "interface entry for %s appeared after %dms",
+			 this->if_name, waited);
+	}
+	row.NlMtu = mtu;
+	/* has to be cleared when writing an IPv4 row back, otherwise the call
+	 * fails with ERROR_INVALID_PARAMETER */
+	row.SitePrefixLength = 0;
+
+	ret = SetIpInterfaceEntry(&row);
+	if (ret != NO_ERROR)
+	{
+		DBG1(DBG_LIB, "setting MTU of %s to %d failed: 0x%08lx",
+			 this->if_name, mtu, ret);
+		return FALSE;
+	}
+	return TRUE;
+}
+
+METHOD(tun_device_t, set_address, bool,
+	private_wintun_device_t *this, host_t *addr, uint8_t netmask)
+{
+	/* the address itself is installed by the networking backend (kernel-iph),
+	 * which charon points at this device via install_virtual_ip_on */
+	DESTROY_IF(this->address);
+	this->address = addr->clone(addr);
+	this->netmask = netmask;
+
+	return TRUE;
+}
+
+METHOD(tun_device_t, get_address, host_t*,
+	private_wintun_device_t *this, uint8_t *netmask)
+{
+	if (netmask && this->address)
+	{
+		*netmask = this->netmask;
+	}
+	return this->address;
+}
+
+METHOD(tun_device_t, up, bool,
+	private_wintun_device_t *this)
+{
+	/* the adapter is up as soon as the session is started */
+	return TRUE;
+}
+
+METHOD(tun_device_t, set_mtu, bool,
+	private_wintun_device_t *this, int mtu)
+{
+	if (!set_iface_mtu(this, mtu, AF_INET))
+	{
+		return FALSE;
+	}
+	this->mtu = mtu;
+
+	return TRUE;
+}
+
+METHOD(tun_device_t, get_mtu, int,
+	private_wintun_device_t *this)
+{
+	return this->mtu;
+}
+
+METHOD(tun_device_t, get_name, char*,
+	private_wintun_device_t *this)
+{
+	return this->if_name;
+}
+
+METHOD(tun_device_t, get_fd, int,
+	private_wintun_device_t *this)
+{
+	return this->fds[0];
+}
+
+METHOD(tun_device_t, write_packet, bool,
+	private_wintun_device_t *this, chunk_t packet)
+{
+	BYTE *buf;
+
+	if (!packet.len || packet.len > WINTUN_MAX_IP_PACKET_SIZE)
+	{
+		DBG1(DBG_LIB, "invalid packet size (%zu bytes) for Wintun device",
+			 packet.len);
+		return FALSE;
+	}
+	buf = WintunAllocateSendPacket(this->session, packet.len);
+	if (!buf)
+	{	/* ring full, drop the packet like a kernel TUN queue would */
+		DBG1(DBG_LIB, "dropping packet, Wintun send ring exhausted");
+		return FALSE;
+	}
+	memcpy(buf, packet.ptr, packet.len);
+	WintunSendPacket(this->session, buf);
+
+	return TRUE;
+}
+
+METHOD(tun_device_t, read_packet, bool,
+	private_wintun_device_t *this, chunk_t *packet)
+{
+	uint8_t hdr[sizeof(uint16_t)];
+	chunk_t data;
+
+	if (!read_all(this->fds[0], hdr, sizeof(hdr)))
+	{
+		return FALSE;
+	}
+	data = chunk_alloc(untoh16(hdr));
+
+	if (!read_all(this->fds[0], data.ptr, data.len))
+	{
+		chunk_free(&data);
+		return FALSE;
+	}
+	*packet = data;
+
+	return TRUE;
+}
+
+METHOD(tun_device_t, destroy, void,
+	private_wintun_device_t *this)
+{
+	if (this->reader)
+	{
+		SetEvent(this->quit);
+		/* the thread might be blocked writing to a socketpair nobody reads
+		 * anymore; closing the other end unblocks it */
+		close(this->fds[0]);
+		this->fds[0] = -1;
+		this->reader->join(this->reader);
+	}
+	if (this->quit)
+	{
+		CloseHandle(this->quit);
+	}
+	if (this->session)
+	{
+		WintunEndSession(this->session);
+	}
+	if (this->adapter)
+	{
+		WintunCloseAdapter(this->adapter);
+	}
+	if (this->fds[0] != -1)
+	{
+		close(this->fds[0]);
+	}
+	if (this->fds[1] != -1)
+	{
+		close(this->fds[1]);
+	}
+	DESTROY_IF(this->address);
+	free(this);
+}
+
+/**
+ * Create the adapter and start a session on it
+ */
+static bool init_wintun(private_wintun_device_t *this)
+{
+	/* a fixed GUID keeps the adapter, and the network profile Windows derives
+	 * from it, stable across runs */
+	static const GUID req_guid = { 0x8f1a5c2e, 0x4b3d, 0x4a91,
+					{ 0x9d, 0x6c, 0x2a, 0x7e, 0x51, 0x0c, 0x33, 0x84 } };
+	GUID guid;
+	DWORD version, ret;
+
+	this->adapter = WintunCreateAdapter(WINTUN_ADAPTER_NAME,
+										WINTUN_TUNNEL_TYPE, &req_guid);
+	if (!this->adapter)
+	{
+		DBG1(DBG_LIB, "creating Wintun adapter failed: 0x%08lx",
+			 GetLastError());
+		return FALSE;
+	}
+	version = WintunGetRunningDriverVersion();
+	DBG2(DBG_LIB, "Wintun driver v%u.%u loaded",
+		 (version >> 16) & 0xff, version & 0xff);
+
+	WintunGetAdapterLUID(this->adapter, &this->luid);
+
+	ret = ConvertInterfaceLuidToGuid(&this->luid, &guid);
+	if (ret != NO_ERROR)
+	{
+		DBG1(DBG_LIB, "getting GUID of Wintun adapter failed: 0x%08lx", ret);
+		return FALSE;
+	}
+	/* charon knows interfaces by the name the networking backend gives them,
+	 * and kernel-iph names them after the adapter's GUID, so this is the name
+	 * the virtual IP and the routes get installed on */
+	snprintf(this->if_name, sizeof(this->if_name),
+			 "{%08lX-%04X-%04X-%02X%02X-%02X%02X%02X%02X%02X%02X}",
+			 (unsigned long)guid.Data1, guid.Data2, guid.Data3,
+			 guid.Data4[0], guid.Data4[1], guid.Data4[2], guid.Data4[3],
+			 guid.Data4[4], guid.Data4[5], guid.Data4[6], guid.Data4[7]);
+
+	this->session = WintunStartSession(this->adapter, WINTUN_RING_CAPACITY);
+	if (!this->session)
+	{
+		DBG1(DBG_LIB, "starting Wintun session failed: 0x%08lx",
+			 GetLastError());
+		return FALSE;
+	}
+	return TRUE;
+}
+
+/*
+ * Described in header
+ */
+wintun_device_t *wintun_device_create(const char *name_tmpl)
+{
+	private_wintun_device_t *this;
+
+	INIT(this,
+		.public = {
+			.tun = {
+				.read_packet = _read_packet,
+				.write_packet = _write_packet,
+				.get_mtu = _get_mtu,
+				.set_mtu = _set_mtu,
+				.get_name = _get_name,
+				.get_fd = _get_fd,
+				.set_address = _set_address,
+				.get_address = _get_address,
+				.up = _up,
+				.destroy = _destroy,
+			},
+		},
+		.mtu = TUN_DEFAULT_MTU,
+		.fds = { -1, -1 },
+	);
+
+	/* Wintun adapters are named, not numbered, so the template is ignored */
+	if (!init_wintun(this))
+	{
+		destroy(this);
+		return NULL;
+	}
+	if (socketpair(AF_INET, SOCK_STREAM, 0, this->fds) != 0)
+	{
+		DBG1(DBG_LIB, "creating socketpair for Wintun device failed");
+		destroy(this);
+		return NULL;
+	}
+	this->quit = CreateEvent(NULL, TRUE, FALSE, NULL);
+	if (!this->quit)
+	{
+		DBG1(DBG_LIB, "creating quit event for Wintun device failed: 0x%08lx",
+			 GetLastError());
+		destroy(this);
+		return NULL;
+	}
+	this->reader = thread_create((thread_main_t)reader_thread, this);
+	if (!this->reader)
+	{
+		DBG1(DBG_LIB, "starting reader thread for Wintun device failed");
+		destroy(this);
+		return NULL;
+	}
+	DBG1(DBG_LIB, "created Wintun device: %s", this->if_name);
+
+	return &this->public;
+}
+
+/*
+ * Described in header
+ */
+bool wintun_library_init()
+{
+	Wintun = LoadLibraryExW(L"wintun.dll", NULL,
+				LOAD_LIBRARY_SEARCH_APPLICATION_DIR |
+				LOAD_LIBRARY_SEARCH_SYSTEM32);
+	if (!Wintun)
+	{
+		DBG1(DBG_LIB, "failed to load Wintun library");
+		return FALSE;
+	}
+
+#define X(Name) ((*(FARPROC *)&Name = GetProcAddress(Wintun, #Name)) == NULL)
+	if (X(WintunCreateAdapter)           || X(WintunCloseAdapter)         ||
+		X(WintunOpenAdapter)             || X(WintunGetAdapterLUID)       ||
+		X(WintunGetRunningDriverVersion) || X(WintunDeleteDriver)         ||
+		X(WintunSetLogger)               || X(WintunStartSession)         ||
+		X(WintunEndSession)              || X(WintunGetReadWaitEvent)     ||
+		X(WintunReceivePacket)           || X(WintunReleaseReceivePacket) ||
+		X(WintunAllocateSendPacket)      || X(WintunSendPacket))
+#undef X
+	{
+		FreeLibrary(Wintun);
+		DBG1(DBG_LIB, "failed to initialize Wintun library");
+		return FALSE;
+	}
+	DBG2(DBG_LIB, "Wintun library loaded and initialized");
+	return TRUE;
+}
+
+/*
+ * Described in header
+ */
+void wintun_library_deinit()
+{
+	if (Wintun)
+	{
+		FreeLibrary(Wintun);
+		Wintun = NULL;
+	}
+}
+
+#endif /* WIN32 */
