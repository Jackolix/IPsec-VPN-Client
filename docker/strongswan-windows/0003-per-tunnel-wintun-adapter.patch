+ */
+static int claim_adapter_slot()
+{
+	int i, slot = -1;
+
+	adapter_mutex->lock(adapter_mutex);
+	for (i = 0; i < WINTUN_MAX_ADAPTERS; i++)
+	{
+		if (!adapter_slots[i])
+		{
+			adapter_slots[i] = TRUE;
+			slot = i;
+			break;
+		}
+	}
+	adapter_mutex->unlock(adapter_mutex);
+
+	return slot;
