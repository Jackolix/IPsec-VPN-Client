# NCP profile files contain live pre-shared keys in plaintext. NEVER commit them.
*.ini
!crates/*/tests/fixtures/*.redacted.ini

# Sophos exports carry the same live PSK: .scx / .tgb hold it in plaintext, the
# .mobileconfig the user portal emits holds it base64-encoded, and .pro names a
# customer's user portal. Customer-supplied files land in Sophos-configs/; only
# redacted fixtures may be committed.
*.scx
*.tgb
*.mobileconfig
*.pro
/Sophos-configs/
!crates/*/tests/fixtures/*.redacted.scx
!crates/*/tests/fixtures/*.redacted.tgb
!crates/*/tests/fixtures/*.redacted.mobileconfig
!crates/*/tests/fixtures/*.redacted.pro

# Host lists shipped beside a profile. No secret in them, but they name a
# customer's internal equipment and addressing — which the security rules say
# is not ours to publish either.
*.hosts.json
!crates/*/tests/fixtures/*.redacted.hosts.json

# Generated connection configs contain the PSK.
/out/
*.swanctl.conf

/target/

# Tauri build-time generated schemas.
crates/vpn-desktop/gen/

# Native daemon build tree (sources + per-arch prefixes).
/build/

# Finder metadata. Uninteresting everywhere, and a dmg build leaves them behind.
.DS_Store
