{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "resources": {
      "../../out/strongswan-windows/*": "charon/",
      "../../out/strongswan-windows/etc/*": "charon/etc/",
      "../../out/broker/*": "./",
      "../../out/openvpn/*": "openvpn/",
      "../../out/openvpn/ssl/modules/*": "openvpn/ssl/modules/"
    },
    "windows": {
      "nsis": {
        "installerHooks": "./installer-hooks.nsh",
        "installMode": "perMachine"
      },
      "wix": {
        "fragmentPaths": ["./installer.wxs"],
        "componentGroupRefs": ["BrokerServiceGroup"]
      }
    }
  }
}
