{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VPN Client",
        "width": 1180,
        "height": 840,
        "minWidth": 380,
        "minHeight": 520,
        "resizable": true,
        "theme": "Dark",
        "visible": false,
        "dragDropEnabled": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ]
  },
  "bundle": {
    "resources": {
      "../../out/strongswan-macos/*": "charon/",
      "../../out/strongswan-macos/etc/*": "charon/etc/",
      "../../out/helper/*": "helper/",
      "../../out/openvpn-macos/*": "openvpn/"
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "background": "dmg/background.tiff",
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 }
      }
    }
  }
}
