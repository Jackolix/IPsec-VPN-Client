{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VPN Client",
        "width": 1180,
        "height": 840,
        "minWidth": 380,
        "minHeight": 520,
        "resizable": true,
        "theme": "Dark",
        "visible": false,
        "dragDropEnabled": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ]
  },
  "bundle": {
    "resources": {
      "../../out/strongswan-macos/*": "charon/",
      "../../out/strongswan-macos/etc/*": "charon/etc/",
      "../../out/helper/*": "helper/"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
