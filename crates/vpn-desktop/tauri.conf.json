{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VPN Client",
  "version": "0.4.4",
  "identifier": "dev.jackolix.ipsecvpn",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "VPN Client",
        "width": 1180,
        "height": 840,
        "minWidth": 380,
        "minHeight": 520,
        "resizable": true,
        "decorations": false,
        "theme": "Dark",
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "nsis", "msi", "deb", "appimage", "dmg"],
    "createUpdaterArtifacts": true,
    "fileAssociations": [
      {
        "ext": ["scx"],
        "name": "VPN Client.scx",
        "description": "Sophos Connect VPN profile",
        "role": "Viewer",
        "mimeType": "application/x-sophos-vpn-profile"
      },
      {
        "ext": ["tgb"],
        "name": "VPN Client.tgb",
        "description": "Sophos VPN profile (legacy)",
        "role": "Viewer",
        "mimeType": "application/x-sophos-vpn-profile"
      },
      {
        "ext": ["pro"],
        "name": "VPN Client.pro",
        "description": "Sophos VPN provisioning file",
        "role": "Viewer",
        "mimeType": "application/x-sophos-vpn-provisioning"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["itmvpn"]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/Jackolix/IPsec-VPN-Client/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMwNDJCOUZEQTI1OEJGMUMKUldRY3YxaWkvYmxDd041UEhGT1gvTENCejdDZlZkb1JBMWoxNSs5VkF1anZYTnEvM0JBTjlFanoK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
