<?xml version="1.0" encoding="utf-8"?>
<!--
  WiX fragment for the MSI: registers the privileged broker as a Windows service,
  the same thing installer-hooks.nsh does for the NSIS installer. NSIS hooks are
  an NSIS-only feature, so without this the MSI would lay vpn-broker.exe down
  next to the app but never register it — and the app, finding no broker, would
  fall back to elevating charon-svc itself on every connect (a UAC prompt and a
  console window; see daemon.rs).

  The actions are deferred and non-impersonated, so they run as LocalSystem from
  the MSI's elevated execution script — creating a service needs that. Both
  ignore their exit code, matching the NSIS hook: a broker that fails to register
  leaves the app in its (working, if noisier) elevate-charon fallback rather than
  failing the whole install.

  Pulled into the package by bundle.windows.wix.componentGroupRefs in
  tauri.windows.conf.json; the marker component below is what that reference
  hangs on, which is what drags the custom actions and their sequencing in.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <ComponentGroup Id="BrokerServiceGroup" Directory="INSTALLDIR">
      <Component Id="BrokerServiceMarker" Guid="0f1c9d9e-6a2b-4a41-9a5f-3a8d5c1f7b42">
        <RegistryValue Root="HKLM"
                       Key="Software\dev.jackolix.ipsecvpn"
                       Name="BrokerService"
                       Type="string"
                       Value="registered-by-installer"
                       KeyPath="yes" />
      </Component>

      <!-- Offer the app for `.ini` without claiming the extension.

           The `.scx`, `.tgb` and `.pro` associations come from
           bundle.fileAssociations, which the WiX template turns into advertised
           ProgIds that own those extensions outright. `.ini` is Windows' generic
           settings-file extension, so it only gets an OpenWithProgids entry
           here: the app appears in Explorer's "Open with" list (and can be made
           the default by the user), while the system default is left alone.
           installer-hooks.nsh does the same thing for the NSIS installer, down
           to the ProgID name.

           The executable is named through `[INSTALLDIR]`, as the broker's custom
           actions below do. A `[#Path]` file reference would be tidier — that is
           the File id Tauri's template gives the main binary — but it fails
           ICE69: this component lives in its own feature, and a formatted string
           may not reference a file belonging to another one. So `vpn-desktop.exe`
           (Tauri's mainBinaryName for this crate) is spelled out, and tracks the
           crate's binary name by hand.

           Win64 so the values land in the real HKLM\Software\Classes rather than
           being redirected into Wow6432Node. -->
      <Component Id="ProfileFileTypes" Guid="a44a4b86-24a8-42f5-bd0b-f200781f163d" Win64="yes">
        <RegistryKey Root="HKLM" Key="Software\Classes\VPN Client.ini">
          <RegistryValue Type="string" Value="NCP VPN profile" KeyPath="yes" />
          <RegistryValue Name="FriendlyTypeName" Type="string" Value="NCP VPN profile" />
        </RegistryKey>
        <RegistryValue Root="HKLM" Key="Software\Classes\VPN Client.ini\DefaultIcon"
                       Type="string" Value="[INSTALLDIR]vpn-desktop.exe,0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\VPN Client.ini\shell"
                       Type="string" Value="open" />
        <RegistryValue Root="HKLM" Key="Software\Classes\VPN Client.ini\shell\open"
                       Type="string" Value="Open with [ProductName]" />
        <RegistryValue Root="HKLM" Key="Software\Classes\VPN Client.ini\shell\open\command"
                       Type="string" Value="&quot;[INSTALLDIR]vpn-desktop.exe&quot; &quot;%1&quot;" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.ini\OpenWithProgids"
                       Name="VPN Client.ini" Type="string" Value="" />

        <!-- The same offer from the application's own side, which is what lists
             it under "Open with" for every profile format it reads. The
             executable's name is part of the key here too. -->
        <RegistryKey Root="HKLM" Key="Software\Classes\Applications\vpn-desktop.exe">
          <RegistryValue Name="FriendlyAppName" Type="string" Value="[ProductName]" />
          <RegistryValue Key="shell\open\command" Type="string"
                         Value="&quot;[INSTALLDIR]vpn-desktop.exe&quot; &quot;%1&quot;" />
          <RegistryValue Key="SupportedTypes" Name=".ini" Type="string" Value="" />
          <RegistryValue Key="SupportedTypes" Name=".scx" Type="string" Value="" />
          <RegistryValue Key="SupportedTypes" Name=".tgb" Type="string" Value="" />
          <RegistryValue Key="SupportedTypes" Name=".pro" Type="string" Value="" />
        </RegistryKey>
      </Component>
    </ComponentGroup>

    <!-- `install` creates the auto-start LocalSystem service and starts it, so no
         reboot is needed; `uninstall` stops it (letting it revert DNS and kill
         charon) and deletes it.

         `install` is also idempotent: over an existing service it repoints the
         binary path at this INSTALLDIR. That matters more here than for NSIS,
         because installer hooks are an NSIS-only feature — the MSI has no way to
         run the old install's uninstaller first, so an MSI laid down beside an
         install made under the app's previous product name would otherwise leave
         the service running the other directory's vpn-broker.exe. See
         installer-hooks.nsh for that migration. -->
    <CustomAction Id="RegisterVpnBroker"
                  Directory="INSTALLDIR"
                  ExeCommand="&quot;[INSTALLDIR]vpn-broker.exe&quot; install"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />
    <CustomAction Id="UnregisterVpnBroker"
                  Directory="INSTALLDIR"
                  ExeCommand="&quot;[INSTALLDIR]vpn-broker.exe&quot; uninstall"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <InstallExecuteSequence>
      <!-- After the files are on disk (vpn-broker.exe has to exist to run it). -->
      <Custom Action="RegisterVpnBroker" After="InstallFiles">NOT REMOVE</Custom>
      <!-- Before they are taken away again, and only on a real uninstall — on an
           upgrade the outgoing version's uninstall does this, then the incoming
           one re-registers. -->
      <Custom Action="UnregisterVpnBroker" Before="RemoveFiles">REMOVE~="ALL"</Custom>
    </InstallExecuteSequence>
  </Fragment>
</Wix>
